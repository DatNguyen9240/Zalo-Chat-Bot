# Zalo Bot Platform - Environment Variables
# Copy file này thành .env và điền thông tin thật

# Port cho Express server
PORT=3000

# Chế độ chạy: webhook (cần ngrok) | polling (không cần ngrok)
BOT_MODE=webhook

# Bot Token - Lấy từ Zalo Bot Manager khi tạo bot
# Dạng: 123456789:abc-xyz
BOT_TOKEN=

# Gemini API Key - Lấy từ https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Model (mặc định: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Webhook Secret Token (tùy chọn) - Tự đặt để xác thực webhook
WEBHOOK_SECRET=

# Log level: debug | info | warn | error (mặc định: info)
LOG_LEVEL=info

# Admin API secret - BẮT BUỘC để truy cập /stats và /admin/*
# Dùng: curl -H "Authorization: Bearer YOUR_SECRET" http://localhost:3000/stats
ADMIN_SECRET=

# Rate limiting - Giới hạn tin nhắn mỗi user
RATE_LIMIT_MAX=10       # Số tin nhắn tối đa (mặc định: 10)
RATE_LIMIT_WINDOW=60000 # Trong khoảng thời gian ms (mặc định: 60000 = 1 phút)

# Google Sheets — URL của Google Apps Script Web App
# Hướng dẫn setup: xem README.md mục "Google Sheets"
GOOGLE_SHEET_URL=
